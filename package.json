{
  "name": "learnharness-raea",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "compare": "node --import tsx scripts/compare.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "install:local": "npm run build && node scripts/install-plugin-local.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "mathjax-full": "3.2.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
